# Copie para .env e preencha. Só a primeira é obrigatória.
ANTHROPIC_API_KEY=<sua-chave-anthropic>

# Opcional: se definido, o /admin passa a exigir este token.
# Ausente, a aplicação sobe e avisa no log. O controle que de fato protege é o
# bind em 127.0.0.1 do docker-compose.yml.
ADMIN_TOKEN=

# Opcional: reproduzir um cenário de instabilidade específico.
QUOTE_FAILURE_RATE=
QUOTE_SLOW_RATE=
QUOTE_SEED=
