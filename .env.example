# Copie para .env e preencha. Só a primeira é obrigatória.
ANTHROPIC_API_KEY=<sua-chave-anthropic>

# ── Acesso à área de operação (/admin) — TUDO OPCIONAL ──────────────────────
#
# Nada aqui é obrigatório, e isso é deliberado: `docker compose up` continua sendo
# um comando só, e quem sobe a aplicação vê as duas áreas sem procurar credencial.
#
# O QUE DE FATO PROTEGE no caminho padrão NÃO é nenhuma destas variáveis: é o bind
# em 127.0.0.1 do docker-compose.yml, que torna a superfície administrativa
# inalcançável da rede independentemente de autenticação. As linhas abaixo existem
# para quem publicar o serviço em outro lugar.
#
# Login com usuário e senha — a área de operação passa a pedir credencial na tela.
# As DUAS precisam estar preenchidas: só uma mantém o /admin aberto, porque
# meia-autenticação parece protegida e não é.
# A senha nunca é comparada nem guardada em texto puro: no boot ela vira um hash
# scrypt com salt e o texto puro sai do ambiente do processo.
# Escolha os valores no SEU .env — este arquivo de exemplo fica vazio de propósito,
# porque o repositório é público.
ADMIN_USER=
ADMIN_PASSWORD=

# Alternativa para máquina (CI, curl): se definido, as rotas /api/* passam a exigir
# o cabeçalho X-Admin-Token. Convive com o login acima.
# Ausente, a aplicação sobe e avisa no log.
ADMIN_TOKEN=

# Opcional: reproduzir um cenário de instabilidade específico.
QUOTE_FAILURE_RATE=
QUOTE_SLOW_RATE=
QUOTE_SEED=
